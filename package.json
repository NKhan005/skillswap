{
  "name": "skillswap",
  "version": "1.0.0",
  "private": true,
  "description": "SkillSwap - No Money Economy Platform. Exchange Skills, Not Money.",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "seed:fresh": "npm --prefix server run seed -- --fresh",
    "test": "npm --prefix server test",
    "build": "npm --prefix client run build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "author": "Gowthami",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  }
}
