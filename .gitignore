# dependencies
node_modules/
.pnp/
.pnp.js

# build output
dist/
build/
coverage/

# environment - .env.example is committed, real secrets never are
.env
.env.local
.env.*.local
!.env.example

# logs
*.log
npm-debug.log*
logs/

# editors / OS
# .vscode is committed deliberately: the extension recommendations, debug
# configurations and tasks are project setup, useful to anyone who clones
# this. Only genuinely personal files are excluded.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db

# docker/dev volumes
mongo-data/

# dev-mongo persistent data
server/.devdata/

# local CI stack secrets
.env.ci
