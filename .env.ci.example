# ############################################################################
# THIS FILE IS A TEMPLATE AND IS COMMITTED TO THE REPOSITORY.
# Never put a real secret in it. Every value below must stay empty.
#
# Real values belong in .env.ci, which is gitignored:
#
#   cp .env.ci.example .env.ci     then edit .env.ci
#
# Note that editing a file through the GitHub web UI ignores .gitignore
# entirely, so a secret pasted there is published even if the filename is
# one git would normally skip. Edit .env.ci locally.
# ############################################################################

# --- Jenkins admin (set before the first start) ---------------------------
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change_me_before_first_start

# --- SonarQube ------------------------------------------------------------
SONAR_DB_PASSWORD=change_me_too

# Admin password for the SonarQube UI. ci/sonar/provision.sh sets this,
# replacing the default admin/admin on first run.
SONAR_ADMIN_PASSWORD=change_me_as_well

# Generated in the SonarQube UI once it is up:
#   My Account > Security > Generate Token (type: Global Analysis Token)
# Leave empty until then; the analysis stage will fail with a clear 401.
SONAR_TOKEN=

# --- Docker Hub (Stage B) -------------------------------------------------
# Use an access token from hub.docker.com > Account Settings > Security,
# never the account password.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# --- Repository the Jenkins job checks out --------------------------------
# Stage A uses the mounted working copy. At Stage B switch to GitHub, e.g.
#   SKILLSWAP_REPO_URL=https://github.com/<you>/skillswap.git
SKILLSWAP_REPO_URL=file:///workspace/skillswap
