# --- SkillSwap API -------------------------------------------------------
NODE_ENV=development
PORT=5000

# Local Docker Mongo:  mongodb://mongo:27017/skillswap
# Local host Mongo:    mongodb://127.0.0.1:27017/skillswap
# Atlas:               mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/skillswap
MONGO_URI=mongodb://127.0.0.1:27017/skillswap

# Public resolvers used for mongodb+srv:// SRV lookups. Leaving the system
# resolver in place is what causes `querySrv ETIMEOUT` on many networks.
DNS_SERVERS=8.8.8.8,1.1.1.1

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list is allowed.
CLIENT_ORIGIN=http://localhost:5173

# Time-credit economics
CREDITS_PER_HOUR=1
SIGNUP_BONUS_CREDITS=3

LOG_LEVEL=info
