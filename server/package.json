{
  "name": "skillswap-server",
  "version": "1.0.0",
  "description": "SkillSwap - No Money Economy Platform. Express + MongoDB + Socket.io API.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/seed/seed.js",
    "test": "node --test tests/*.test.js",
    "lint": "echo \"no linter configured\" && exit 0",
    "mongo:dev": "node scripts/dev-mongo.js",
    "test:unit": "node --test tests/trustScore.test.js tests/matching.test.js",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout tests/*.test.js && node scripts/lcov-paths.js"
  },
  "keywords": [
    "skillswap",
    "barter",
    "time-credits",
    "express",
    "mongodb"
  ],
  "author": "Gowthami",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.0"
  }
}
