# Normalise to LF in the repository. Windows checkouts still get CRLF for
# editing, but anything copied into a Linux container keeps LF - CRLF in a
# Dockerfile, shell script or nginx.conf fails in confusing ways.
* text=auto eol=lf

*.sh      text eol=lf
Dockerfile text eol=lf
*.conf    text eol=lf
Jenkinsfile text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.svg text eol=lf
